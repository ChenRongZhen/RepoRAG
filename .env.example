# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交。
# 二选一：
# 公司网关（OpenAI 兼容路径带 /v1）
# OPENAI_BASE_URL=https://token.vongcloud.com/v1
# DeepSeek 官方
# OPENAI_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# 文档目录（默认 ../CoreCoder，可指向任意含 README_CN.md 与 article/*.md 的目录）
# CORECODER_DOCS_DIR=../CoreCoder

# GitHub Issues 补充检索（只读公开数据）
GITHUB_TOKEN=
GITHUB_REPO=he-yufeng/CoreCoder

# 检索与判定
TOP_K=3
SCORE_THRESHOLD=0.72
BORDERLINE_LOW=0.45
